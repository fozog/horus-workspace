MEMORY=$1
shift
INTERFACES=$*

sudo dpdk-hugepages.py --setup $MEMORY --user "$USER"

function dpaa2_init()
{
    echo dpni.5 | sudo tee /sys/bus/fsl-mc/drivers/fsl_dpaa2_eth/unbind
    sudo -E restool dpni destroy dpni.5

    # create kernel objects to allow DPDK to use the port
    export DPRC=dprc.2
    export MAX_QUEUES=4
    export MAX_TCS=1
    sudo -E dynamic_dpl.sh dpmac.9
}

function af_xdp_init()
{
    XDP_SUPPORTED=$(sudo xdp-loader features $1 | grep NETDEV_XDP_ACT_BASIC | cut -d':' -f2)
    EAL="--vdev=net_af_xdp0,iface=$1,queue_count=1"
    if [ "$XDP_SUPPORTED" != "yes" ]; then
        EAL="${EAL},mode=skb"
    fi
    echo "use EAL parameters: $EAL"
}

for intf in $INTERFACES
do
    PMD=$(./netif2pmd.py  $intf | grep "PMD name" | sort | uniq | cut -d':' -f2)

    ${PMD}_init $intf
done


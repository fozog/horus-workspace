{
  "folders": [
    {
      "name": "horus-workspace",
      "path": "."
    },
    {
      "name": "probe",
      "path": "horus"
    },
    {
      "name": "webUI",
      "path": "horus-agent"
    },
    {
      "name": "delegate",
      "path": "horus-delegate"
    }
  ],
  "settings": {},
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "probe: build debug",
        "type": "process",
        "command": "make",
        "args": ["debug"],
        "options": { "cwd": "${workspaceFolder:probe}" },
        "group": "build",
        "problemMatcher": ["$gcc"]
      },
      {
        "label": "probe: build release",
        "type": "process",
        "command": "make",
        "args": ["release"],
        "options": { "cwd": "${workspaceFolder:probe}" },
        "group": "build",
        "problemMatcher": ["$gcc"]
      },
      {
        "label": "webUI: build release",
        "type": "process",
        "command": "npm",
        "args": ["run", "build"],
        "options": { "cwd": "${workspaceFolder:webUI}" },
        "group": "build",
        "problemMatcher": ["$tsc"]
      },
      {
        "label": "workspace: build release",
        "dependsOn": ["probe: build release", "webUI: build release"],
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "probe: prepare run dir",
        "type": "shell",
        "command": "sudo install -d -m 0775 -o root -g $(id -gn) /var/run/horus",
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "compounds": [
      {
        "name": "Probe+WebUI (Release)",
        "configurations": [
          { "folder": "webUI", "name": "Horus-agent (Release)" },
          { "folder": "probe", "name": "Horus(IXGBE) (Release)" }
        ],
        "preLaunchTask": "probe: prepare run dir",
        "stopAll": true
      },
      {
        "name": "Probe+WebUI",
        "configurations": [
          { "folder": "webUI", "name": "Horus-agent (Node.js)" },
          { "folder": "probe", "name": "Horus(IXGBE)" }
        ],
        "preLaunchTask": "probe: prepare run dir",
        "stopAll": true
      }
    ]
  }
}

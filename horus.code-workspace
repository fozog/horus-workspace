{
  "folders": [
    {
      "name": "horus-workspace",
      "path": "."
    },
    {
      "name": "probe",
      "path": "horus"
    },
    {
      "name": "agent",
      "path": "horus-agent"
    }
  ],
  "settings": {},
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "prepare horus run dir",
        "type": "shell",
        "command": "sudo install -d -m 0775 -o root -g $(id -gn) /var/run/horus",
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "compounds": [
      {
        "name": "Probe+Agent",
        "configurations": [
          { "folder": "agent", "name": "Horus-agent (Node.js)" },
          { "folder": "probe", "name": "Horus(AF_XDP)" }
        ],
        "preLaunchTask": "prepare horus run dir",
        "stopAll": true
      }
    ]
  }
}
